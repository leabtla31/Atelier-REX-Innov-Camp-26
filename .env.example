# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FACILITATOR_PASSCODE: Optional server-side passcode for Mode Animateur (Node backend).
# If left empty, the first facilitator opening Mode Animateur can set it in-app.
FACILITATOR_PASSCODE=

# Supabase (for static GitHub Pages deployment with Realtime sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
